{
  "title": "Leviia MCP — Supervision",
  "uid": "leviia-mcp-supervision",
  "timezone": "browser",
  "panels": [
    {"id": 1, "type": "stat", "title": "Appels MCP (1j)", "gridPos": {"x":0,"y":0,"w":6,"h":4},
     "targets": [{"expr": "leviia_mcp_calls_total", "refId": "A"}]},
    {"id": 2, "type": "stat", "title": "Crédits API consommés", "gridPos": {"x":6,"y":0,"w":6,"h":4},
     "targets": [{"expr": "leviia_credits_total", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Feedbacks (bugs)", "gridPos": {"x":12,"y":0,"w":6,"h":4},
     "targets": [{"expr": "leviia_feedback_total{severity=\"bug\"}", "refId": "A"}]},
    {"id": 8, "type": "stat", "title": "Images indexées", "gridPos": {"x":0,"y":4,"w":6,"h":4},
     "targets": [{"expr": "leviia_index_total{type=\"image\"} - leviia_index_not_analyzed{type=\"image\"}", "refId": "A"}]},
    {"id": 9, "type": "stat", "title": "Images non analysées", "gridPos": {"x":6,"y":4,"w":6,"h":4},
     "targets": [{"expr": "leviia_index_not_analyzed{type=\"image\"}", "refId": "A"}]},
    {"id": 10, "type": "stat", "title": "Images confiance <70 (haut doute)", "gridPos": {"x":12,"y":4,"w":6,"h":4},
     "targets": [{"expr": "leviia_index_low_confidence{type=\"image\",threshold=\"<70\"}", "refId": "A"}]},
    {"id": 11, "type": "stat", "title": "Vidéos indexées", "gridPos": {"x":18,"y":4,"w":6,"h":4},
     "targets": [{"expr": "leviia_index_total{type=\"video\"} - leviia_index_not_analyzed{type=\"video\"}", "refId": "A"}]},
    {"id": 12, "type": "timeseries", "title": "Images par modèle d'analyse", "gridPos": {"x":0,"y":8,"w":12,"h":8},
     "targets": [{"expr": "leviia_index_by_model{type=\"image\"}", "refId": "A", "legendFormat": "{{model}}"}]},
    {"id": 13, "type": "timeseries", "title": "Vidéos par modèle d'analyse", "gridPos": {"x":12,"y":8,"w":12,"h":8},
     "targets": [{"expr": "leviia_index_by_model{type=\"video\"}", "refId": "A", "legendFormat": "{{model}}"}]},
    {"id": 14, "type": "timeseries", "title": "Images basse confiance par seuil", "gridPos": {"x":0,"y":16,"w":12,"h":8},
     "targets": [{"expr": "leviia_index_low_confidence{type=\"image\"}", "refId": "A", "legendFormat": "{{threshold}}"}]},
    {"id": 15, "type": "timeseries", "title": "Vidéos basse confiance par seuil", "gridPos": {"x":12,"y":16,"w":12,"h":8},
     "targets": [{"expr": "leviia_index_low_confidence{type=\"video\"}", "refId": "A", "legendFormat": "{{threshold}}"}]},
    {"id": 4, "type": "timeseries", "title": "Crédits par catégorie", "gridPos": {"x":0,"y":24,"w":12,"h":8},
     "targets": [{"expr": "leviia_credits_by_category", "refId": "A", "legendFormat": "{{category}}"}]},
    {"id": 5, "type": "timeseries", "title": "p95 latency par outil (ms)", "gridPos": {"x":12,"y":24,"w":12,"h":8},
     "targets": [{"expr": "leviia_tool_p95_ms", "refId": "A", "legendFormat": "{{tool}}"}]},
    {"id": 6, "type": "timeseries", "title": "Taux d'erreur par outil (%)", "gridPos": {"x":0,"y":32,"w":12,"h":8},
     "targets": [{"expr": "leviia_tool_error_rate", "refId": "A", "legendFormat": "{{tool}}"}]},
    {"id": 7, "type": "timeseries", "title": "Appels par outil", "gridPos": {"x":12,"y":32,"w":12,"h":8},
     "targets": [{"expr": "leviia_tool_calls_total", "refId": "A", "legendFormat": "{{tool}}"}]}
  ],
  "schemaVersion": 39,
  "version": 2
}
